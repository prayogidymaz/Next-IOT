board = {{ board }}
framework = arduino
monitor_speed = 115200
lib_deps =
    knolleary/PubSubClient@^2.8
    bblanchon/ArduinoJson@^7.2.1
{% for lib in libraries %}
    {{ lib }}
{% endfor %}
build_flags =
    -DCORE_DEBUG_LEVEL=1
