#include <Arduino.h>
#include <NextIotClient.h>
#include <NextIotConfig.h>
{% for row in sensors %}
{% if row.include_header %}{{ row.include_header }}
{% endif %}
{% endfor %}

NextIotConfig iotConfig = {
    .wifi_ssid = "{{ config.wifi_ssid }}",
    .wifi_password = "{{ config.wifi_password }}",
    .broker_host = "{{ config.broker_host }}",
    .broker_port = {{ config.broker_port }},
    .use_tls = {{ "true" if config.use_tls else "false" }},
    .ca_cert_pem = nullptr,
{{ credential_block }}
    .keepalive_seconds = 30,
    .reconnect_delay_ms = 5000,
    .enable_ota = {{ "true" if config.enable_ota else "false" }},
    .device_profile_json = R"THING_MODEL({{ thing_model_json }})THING_MODEL",
};

NextIotClient client(iotConfig);

{% for row in sensors %}
{% if row.global_decl %}{{ row.global_decl }}
{% endif %}
{% endfor %}

static unsigned long lastPublishMs = 0;
static const unsigned long publishIntervalMs = {{ config.publish_interval_s * 1000 }};

void setup() {
  Serial.begin(115200);
  delay(200);
{% for row in sensors %}
{% if row.init_code %}  {{ row.init_code }}
{% endif %}
{% endfor %}
  client.begin();
{% if config.enable_ota %}
  client.enableOta();
{% endif %}
}

void loop() {
  client.loop();
  const unsigned long now = millis();
  if (now - lastPublishMs < publishIntervalMs) {
    return;
  }
  lastPublishMs = now;

  StaticJsonDocument<512> values;
{% for row in sensors %}
  values["{{ row.metric }}"] = {{ row.read_expr }};
{% endfor %}
  client.publishTelemetry(values.as<JsonObject>());
}
