{
  "uid": "next-iot-infra",
  "title": "Next-IoT Infrastructure",
  "tags": ["next-iot", "infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Postgres connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"nextiot\"}",
          "legendFormat": "connections"
        }
      ]
    },
    {
      "id": 2,
      "title": "Container CPU",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"next-iot.*\"}[5m])",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis memory (if exported)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "bytes"
        }
      ]
    }
  ]
}
