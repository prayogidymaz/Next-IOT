# Copy to .env.production and fill secrets before: docker compose -f docker-compose.prod.yml up -d

# ── Public URLs (reverse proxy) ───────────────────────────────
PUBLIC_HOST=iot.example.com
PUBLIC_API_URL=https://iot.example.com/api
PUBLIC_APP_URL=https://iot.example.com
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ── Application ───────────────────────────────────────────────
APP_NAME=Next-IOT
APP_ENV=production
API_DEBUG=false
API_WORKERS=4

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=next_iot
POSTGRES_USER=next_iot
POSTGRES_PASSWORD=change-me-strong-db-password

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ── JWT / Auth ───────────────────────────────────────────────
JWT_SECRET_KEY=change-me-long-random-jwt-secret-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=https://iot.example.com
CORS_ALLOW_CREDENTIALS=true

# ── MQTT (Mosquitto) ─────────────────────────────────────────
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USERNAME=iot_bridge
MQTT_PASSWORD=change-me-mqtt-password

# ── LoRa / Hardware bridge (optional sidecar) ────────────────
LORA_BRIDGE_SERIAL_PORT=/dev/ttyUSB0
LORA_BRIDGE_API_BASE_URL=http://api:8000
LORA_ENCRYPTION_KEY=00112233445566778899aabbccddeeff
LORA_ENCRYPTION_ENABLED=true

# ── Seed (disable in production after bootstrap) ─────────────
SEED_DEFAULT_ADMIN=false
SEED_DEMO_TELEMETRY=false

# ── Notifications ────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ── Edge access (colocation / tunnel) ────────────────────────
# Tailscale hostname or Cloudflare Tunnel public hostname
TAILSCALE_HOST=next-iot-edge
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_HOSTNAME=iot.example.com
