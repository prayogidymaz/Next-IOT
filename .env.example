# ── Application ──────────────────────────────────────────────
APP_NAME=Next-IOT
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=next_iot
POSTGRES_USER=next_iot
POSTGRES_PASSWORD=changeme

# Optional — if omitted or left with ${...} placeholders, URLs are built from POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://next_iot:changeme@postgres:5432/next_iot
DATABASE_URL_SYNC=postgresql://next_iot:changeme@postgres:5432/next_iot
# Pytest uses DB next_iot_test (created automatically) unless DATABASE_URL_TEST is set.
# DATABASE_URL_TEST=postgresql+asyncpg://next_iot:changeme@postgres:5432/next_iot_test
# TEST_DATABASE_NAME=next_iot_test
# DB_ECHO=true  # SQLAlchemy echo (dev only; never in production compose)

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
# Pytest uses a separate Redis logical DB (default index 15) unless REDIS_URL_TEST is set.
# REDIS_URL_TEST=redis://${REDIS_HOST}:${REDIS_PORT}/15
# REDIS_TEST_DB_INDEX=15

# ── JWT (used in Task #2) ────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Device Lifecycle ─────────────────────────────────────────
DEVICE_PROVISIONING_TOKEN_EXPIRE_HOURS=24
DEVICE_HEARTBEAT_OFFLINE_THRESHOLD_SECONDS=300
DEVICE_OFFLINE_CHECK_INTERVAL_SECONDS=60

# ── Telemetry Engine ───────────────────────────────────────────
TELEMETRY_TIMESTAMP_MAX_FUTURE_MINUTES=5
TELEMETRY_TIMESTAMP_MAX_PAST_HOURS=24

# ── CORS (Flutter Web / dashboard) ─────────────────────────────
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# ── Default admin seed (auto on API startup) ─────────────────────
SEED_DEFAULT_ADMIN=true
SEED_ADMIN_EMAIL=admin@nextiot.com
SEED_ADMIN_PASSWORD=admin123
SEED_TENANT_NAME=Next-IOT Platform
SEED_TENANT_SLUG=nextiot
SEED_DEMO_TELEMETRY=true

# ── Notification Dispatcher ───────────────────────────────────────
NOTIFICATION_DISPATCHER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=1.0
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY_SECONDS=0.5

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
DEFAULT_TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10.0
WEBHOOK_SIGNATURE_HEADER=X-NextIOT-Signature

# ── MQTT / EMQX ───────────────────────────────────────────────
MQTT_PORT=11883
# Default external MQTT port for Windows dev (avoids conflict with Mosquitto service on 1883).
# Linux/Mac dev without a local broker can set MQTT_PORT=1883.
NEXT_PUBLIC_MQTT_BROKER_URL=mqtt://localhost:11883
# Must match infra/emqx/cluster-override.conf x-internal-secret (EMQX HOCON does not read this env).
MQTT_WEBHOOK_SHARED_SECRET=dev-mqtt-webhook-secret
# REST API (rule setup) — must match infra/emqx/api-keys.conf (key:secret only; no # comments).
EMQX_API_KEY=nextiot-api-key
EMQX_API_SECRET=nextiot-api-secret-change-in-prod
EMQX_DASHBOARD_URL=http://emqx:18083
# Step 3C: Python asyncio-mqtt subscriber (replaces EMQX rule engine for telemetry).
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883
MQTT_SUBSCRIBER_ENABLED=true
MQTT_DEBUG_RAW_BODY=false
MQTT_SUBSCRIBER_INTERNAL_USER=next-iot-subscriber
MQTT_SUBSCRIBER_INTERNAL_PASSWORD=next-iot-subscriber-dev-password
EMQX_TELEMETRY_RULE_SETUP_ENABLED=false
